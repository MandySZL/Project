generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String? @unique
  password         String?
  role             String   // "MENTOR" or "ADMIN"
  totalLeaveDays   Int      @default(0)
  usedLeaveDays    Int      @default(0)

  // Relations for Mentor
  requestsAsMentor     LeaveRequest[] @relation("MentorRequests")
  requestsAsSubstitute LeaveRequest[] @relation("SubstituteRequests")
}

model ClassSession {
  id            String   @id @default(cuid())
  time          DateTime
  leaveLimit    Int      @default(1)
  currentLeaves Int      @default(0) // Can also be calculated, but denormalized for simplicity
}

model LeaveRequest {
  id           String   @id @default(cuid())
  status       String   // "PENDING_SUBSTITUTE", "PENDING_ADMIN", "APPROVED", "REJECTED"
  
  mentorId     String
  mentor       User     @relation("MentorRequests", fields: [mentorId], references: [id])
  
  substituteId String
  substitute   User     @relation("SubstituteRequests", fields: [substituteId], references: [id])
  
  requestDate  DateTime
  sessionText  String
  wasApproved  Boolean  @default(false)
  firstAdminId String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
